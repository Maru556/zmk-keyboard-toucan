// Toucan ZMK Keymap — converted from Dilemma Dvorak QMK layout
// Layout: LAYOUT_split_3x5_3

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define SYM   1
#define NUM   2
#define FUN   3
#define BT    4

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33 34 35>;
            hold-trigger-on-release;
        };
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: BASE (Dvorak)
        // '  ,  .  P  Y  |  F  G  C  R  L
        // A  O  E  U  I  |  D  H  T  N  S
        // ;  Q  J  K  X  |  B  M  W  V  Z
        //    ENT (NUM)TAB SPC | ESC (SYM)DEL BSPC
        base_layer {
            label = "BASE";
            bindings = <
                &kp QUOT       &kp COMMA     &kp DOT      &kp P        &kp Y
                &kp F          &kp G         &kp C        &kp R        &kp L

                &hml LGUI A    &hml LALT O   &hml LCTRL E &hml LSHFT U &lt FUN I
                &lt BT D       &hmr LSHFT H  &hmr LCTRL T &hmr LALT N  &hmr LGUI S

                &kp SEMI       &kp Q         &kp J        &kp K        &kp X
                &kp B          &kp M         &kp W        &kp V        &kp Z

                &kp RET        &lt NUM TAB   &kp SPACE
                &kp ESC        &lt SYM DEL   &kp BSPC
            >;
        };

        // Layer 1: SYM (Symbols)
        sym_layer {
            label = "SYM";
            bindings = <
                &kp DQT        &kp LT        &kp GT       &kp ASTRK    &kp EQUAL
                &kp EXCL       &kp LPAR      &kp RPAR     &kp GRAVE    &kp TILDE

                &kp AT         &kp DLLR      &kp PLUS     &kp PIPE     &kp PRCNT
                &none          &kp LBRC      &kp RBRC     &kp MINUS    &kp UNDER

                &kp COLON      &kp HASH      &kp BSLH     &kp CARET    &kp AMPS
                &none          &kp LBKT      &kp RBKT     &kp SLASH    &kp QMARK

                &none          &none         &none
                &none          &none         &none
            >;
        };

        // Layer 2: NUM (Numbers + Nav)
        num_layer {
            label = "NUM";
            bindings = <
                &kp N1         &kp N2        &kp N3       &kp N4       &kp N5
                &kp F22        &kp F13       &kp F14      &kp F15      &kp RIGHT

                &kp N6         &kp N7        &kp N8       &kp N9       &kp N0
                &kp F23        &kp LEFT      &kp F19      &kp F20      &kp F21

                &kp DOT        &kp COMMA     &kp DOWN     &kp UP       &none
                &kp F24        &kp F16       &kp F17      &kp F18      &none

                &none          &none         &none
                &none          &none         &none
            >;
        };

        // Layer 3: FUN (Function + Media)
        fun_layer {
            label = "FUN";
            bindings = <
                &caps_word     &sk LSHFT     &kp LC(Z)    &kp LC(X)    &none
                &kp C_VOL_UP   &kp F1        &kp F2       &kp F3       &kp F4

                &kp LC(C)      &kp LC(V)     &kp LC(A)    &kp LC(F)    &none
                &kp C_VOL_DN   &kp F5        &kp F6       &kp F7       &kp F8

                &kp LC(LS(C))  &kp LC(LS(V)) &kp CAPS     &none        &none
                &kp LG(LS(S))  &kp F9        &kp F10      &kp F11      &kp F12

                &none          &kp LG(END)   &kp LG(HOME)
                &kp C_PREV     &kp C_NEXT    &kp C_PP
            >;
        };

        // Layer 4: BT (Bluetooth + Output)
        // Replaces Dilemma DPI/SNIPING/DRGSCRL — no ZMK equivalent
        bt_layer {
            label = "BT";
            bindings = <
                &bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
                &none          &none         &none         &none        &none

                &out OUT_TOG   &out OUT_BLE  &out OUT_USB  &none        &none
                &none          &none         &none         &none        &none

                &none          &none         &none         &none        &none
                &none          &none         &none         &none        &none

                &none          &none         &none
                &none          &none         &none
            >;
        };
    };
};
