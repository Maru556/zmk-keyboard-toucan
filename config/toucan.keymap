  #include <behaviors.dtsi>
  #include <dt-bindings/zmk/keys.h>
  #include <dt-bindings/zmk/bt.h>
  #include <dt-bindings/zmk/ext_power.h>

  / {
    keymap {
      compatible = "zmk,keymap";
  layer0 {
          bindings = <
          &kp SINGLE_QUOTE &kp COMMA &kp DOT &kp P &kp Y &kp F &kp G &kp C &kp R &kp L &mt LEFT_GUI A &mt LEFT_ALT O &mt LEFT_CONTROL E &mt LEFT_SHIFT U &lt 3 I &lt 4 D &mt LEFT_SHIFT H &mt LEFT_CONTROL T &mt LEFT_ALT N &mt LEFT_GUI S &kp SEMICOLON &kp Q &kp J &kp K &kp X &kp B &kp M &kp W &kp V &kp Z &kp ENTER &lt 2 TAB &kp SPACE &kp ESCAPE &lt 1 DELETE &kp BACKSPACE
          >;
        };layer1 {
          bindings = <
          [[KC_DQUO]] [[KC_LT]] [[KC_GT]] [[KC_ASTR]] &kp EQUAL [[KC_EXLM]] [[KC_LPRN]] [[KC_RPRN]] &kp GRAVE [[KC_TILD]] [[KC_AT]] [[KC_DLR]] [[KC_PLUS]] [[KC_PIPE]] [[KC_PERC]] &none [[KC_LCBR]] [[KC_RCBR]] &kp MINUS [[KC_UNDS]] [[KC_COLN]] [[KC_HASH]] &kp BACKSLASH [[KC_CIRC]] [[KC_AMPR]] &none &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp SLASH [[KC_QUES]] &none &none &none &none &none &none
          >;
        };layer2 {
          bindings = <
          &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp F22 &kp F13 &kp F14 &kp F15 &kp RIGHT &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp F23 &kp LEFT &kp F19 &kp F20 &kp F21 &kp DOT &kp COMMA &kp DOWN &kp UP &none &kp F24 &kp F16 &kp F17 &kp F18 &none &none &none &none &none &none &none
          >;
        };layer3 {
          bindings = <
          [[CW_TOGG]] [[OS_LSFT]] [[C(KC_Z)]] [[C(KC_X)]] &none &kp C_VOLUME_UP &kp F1 &kp F2 &kp F3 &kp F4 [[C(KC_C)]] [[C(KC_V)]] [[C(KC_A)]] [[C(KC_F)]] &none &kp C_VOLUME_DOWN &kp F5 &kp F6 &kp F7 &kp F8 [[C(S(KC_C))]] [[C(S(KC_V))]] &kp CAPSLOCK &none &none [[OS_LSG]] &kp F9 &kp F10 &kp F11 &kp F12 &none [[G(KC_END)]] [[G(KC_HOME)]] &kp C_PREVIOUS &kp C_NEXT &kp C_PLAY_PAUSE
          >;
        };layer4 {
          bindings = <
          [[RGB_TOG]] [[DPI_MOD]] &mt LEFT_SHIFT F20 &mt LEFT_SHIFT F20 [[DRGSCRL]] &none &none &none &none &none [[DT_UP]] [[DT_DOWN]] [[DT_PRNT]] &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none
          >;
        };
    };
  };
  
